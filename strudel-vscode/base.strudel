// Melodia celtica

// $: note("<62 60 57 55 57 55 54 50 52 54 62 60 57 57 59 57 55 57 62 64 66 64 62 60 57 55 57 55 54 50 52 54 55 57 62 62 66 64 62 64 60 57 55 57 59 55 57 55 54 50 52 54 62 60 57 57 59 57 55 57 62 64 66 64 62 60 57 55 57 55 54 50 52 54 55 57 62 62 66 64 62 64 60 57 55 57 62 62 66 64 62 60 57 59 60 57 55 57 62 62 66 64 62 64 60 57 55 57 62 62 66 64 62 60 57 59 60 62 64 66 69 67 64 66 62 60 57 54 55 57 62 62 66 64 62 60 57 59 60 57 55 57 62 62 66 64 62 64 60 57 55 57 62 62 66 64 62 60 57 59 60 62 64 66 69 67 64 66 62 60 57 54 55>*8").sound("piano")


// Funções de efeito

// .lpf()   : quanto maior, maior o abafamento do som, colocando aspas duplas a batida vai variando de lpf. ex (.lpf("800 1000 600 1000"))
// .vowel() : método que transforma números em vogais para serem usadas como samples (amostras de som). ex .vowel("<a e i o>")
// .gain()  : aumenta o "volume" da musica em algumas partes e diminui em outras .gain(".4 .7")
